# Allowlist: only what the server needs is sent to the Docker daemon, so
# training code, datasets, saved models and caches stay out of the image.
*
!requirements.txt
!start_server.sh
!build_models
!src/__init__.py
!src/common
!src/models
!src/production

# Re-exclude junk inside the allowed paths
**/__pycache__
**/*.pyc
**/*.bat
**/.env
**/*.env
